# ─────────────────────────────────────────────────────────────────────────────
#  .env.hsm-dev.example — Sansec HSM docker dev profili konfigürasyonu
# ─────────────────────────────────────────────────────────────────────────────
#  KULLANIM:
#    cp devops/docker/.env.hsm-dev.example devops/docker/.env.hsm-dev
#    (.env.hsm-dev .gitignore'da → PIN commit'e sızmaz)
#
#  Sonra:
#    docker compose -f devops/docker/docker-compose.hsm-dev.yml \
#         --env-file devops/docker/.env.hsm-dev up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Zorunlu ──────────────────────────────────────────────────────────────────
# libupkcs11.so + libswsds.so + swsds0.ini + upkcs11.ini + OBJSP02 cache içeren
# HOST dizini. Container'a /opt/hsm olarak mount edilir.
HSM_LIB_DIR=/Users/erdembas/Downloads/20260608/project

# HSM PKCS#11 login PIN'i (C_Login). Sansec HSM operatöründen alınır.
CERTIFICATE_PIN=REPLACE_WITH_YOUR_PIN

# ── Sertifika seçimi (opsiyonel; birden fazla anahtar varsa) ──────────────────
#CERTIFICATE_ALIAS=
#CERTIFICATE_SERIAL_NUMBER=

# ── PKCS#11 override (opsiyonel) ──────────────────────────────────────────────
#PKCS11_SLOT=-1
#PKCS11_SLOT_LIST_INDEX=-1
#PKCS11_NULL_INIT_ARGS=false
#MAX_SESSION_COUNT=10

# ── Logging (opsiyonel) ───────────────────────────────────────────────────────
#LOG_LEVEL=DEBUG
